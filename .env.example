# Supabase project credentials (required for persisted applications and CMS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required only for Super Admin user invitations and account management.
SUPABASE_SERVICE_ROLE_KEY=
# Configure after Razorpay account and webhook setup. Never expose secrets to browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional notification, analytics, and public domain settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
